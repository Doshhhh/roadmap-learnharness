{
  "name": "roadmap-learnharness",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "description": "Roadmap community plugin for LearnHarness: learning roadmaps drawn like roadmap.sh, built by an Architect from real sources.",
  "scripts": {
    "sdk": "node scripts/sdk.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "node scripts/check-sdk.mjs && tsc --noEmit",
    "test": "node --test tests/*.test.mjs tests/*.test.ts",
    "check": "npm run typecheck && npm run build && npm test && node scripts/check-version.mjs",
    "install:local": "npm run build && node scripts/install-plugin-local.mjs",
    "restart:learnharness": "node scripts/restart-learnharness.mjs --restart"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "linkedom": "^0.18.13",
    "typebox": "^1.3.27",
    "typescript": "5.9.3"
  }
}
